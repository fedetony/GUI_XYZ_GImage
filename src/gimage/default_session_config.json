{
  "machine": {
    "machine_type": {
      "value": "laser_2axis",
      "unit": "",
      "type": "str",
      "info": "Machine type (laser, cnc, plotter, etc.)",
      "user_modifiable": false,
      "meta":{
        "editable":false
      }
    },

    "name": {
      "value": "laser machine",
      "unit": "",
      "type": "str",
      "info": "Machine name"
    },

    "axis_count": {
      "value": 2,
      "unit": "",
      "type": "int",
      "info": "Number of motion axes available",
      "user_modifiable": false
    },

    "axes": {
      "value": ["X", "Y"],
      "unit": "",
      "type": "list",
      "subtype": "str",
      "meta":{
        "constraints": {
          "arity": 2
           }
      },
      "info": "List of axis names",
      "user_modifiable": false
    },

    "work_area": {
      "value": [400, 420],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "info": "Maximum reachable XY area"
    },

    "max_speed": {
      "value": 5000,
      "unit": "mm/min",
      "type": "int",
      "info": "Maximum allowed movement speed"
    },

    "home_position": {
      "value": [0, 0, 0],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "meta":{
        "constraints": {
          "arity": 3
           }
      },
      "info": "Machine home position in workspace coordinates"
    }
  },

  "tool": {
    "tool_type": {
      "value": "laser",
      "unit": "",
      "type": "str",
      "info": "Tool type (pencil, laser, cutter, etc.)",
      "user_modifiable": false,
      "meta":{
        "editable":false
      }
    },

    "tool_tip_shape": {
      "value": "Cylindrical",
      "unit": "",
      "type": "str",
      "info": "Shape of the tool tip",
      "meta":{
      "options": ["Cylindrical", "Conical", "Spherical"]
      }
    },

    "tool_tip_size": {
      "value": 0.1,
      "unit": "mm",
      "type": "float",
      "info": "Diameter or effective contact width"
    },

    "tool_tip_contact_offset": {
      "value": [0, 0, 0],
      "unit": "mm",
      "type": "coords",
      "subtype": "float",
      "meta":{
        "constraints": {
          "arity": 3
           }
      },
      "info": "Offset between tool tip and machine reference point"
    },

    "park_position": {
      "value": [419, 0],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "meta":{
        "constraints": {
          "arity": 2
           }
      },
      "info": "Position where tool is parked when idle"
    },

    "tool_z_correction": {
      "value": 0.1,
      "unit": "mm/m",
      "type": "float",
      "info": "Z correction per meter of tool wear",
      "meta":{"hidden":false,
              "conditions": "me_set('meta[hidden]',False) if node_get('technique[technique_type]') == 'pencil' else me_set('meta[hidden]',True)"}
    },

    "tool_change": {
      "value": false,
      "unit": "",
      "type": "bool",
      "info": "Enable tool change routine"
    },

    "tool_change_per_layer": {
      "value": false,
      "unit": "",
      "type": "bool",
      "info": "Perform tool change after every layer",
      "meta":{"hidden":false,
              "conditions": "me_set('meta[hidden]',False) if node_get('tool[tool_change[value]]') == True else me_set('meta[hidden]',True)"}
    },

    "tool_change_in_layers": {
      "value": [-1],
      "unit": "",
      "type": "list",
      "subtype": "int",
      "meta":{
        "hidden":false,
        "constraints": {
          "arity": 2
           },
        "conditions": "me_set('meta[hidden]',False) if (node_get('tool[tool_change[value]]') == True and node_get('tool[tool_change_per_layer[value]]') == True ) else me_set('meta[hidden]',True)"
      },
      "info": "List of layers requiring tool change (-1 = all)"
    }
  },

  "workspace": {
    "material": {
      "value": "wood",
      "unit": "",
      "type": "str",
      "info": "Material type",
      "meta":{
      "options": ["wood", "paper", "canvas", "plastic"]
      }
    },

    "size": {
      "value": [297.0, 210.0],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "meta":{
        "hidden":false,
        "constraints": {
          "arity": 2
           }
      },
      "info": "Dimensions of the material"
    },

    "offset": {
      "value": [10, 10, 4.0],
      "unit": "mm",
      "type": "coords",
      "subtype": "float",
      "meta":{
        "hidden":false,
        "constraints": {
          "arity": 3
           }
      },
      "info": "Offset from machine home to material origin"
    }
  },

  "technique": {
    "technique_type": {
      "value": "vectorize",
      "unit": "",
      "type": "str",
      "info": "Processing technique",
      "user_modifiable": false,
      "meta":{
        "editable":false
      }
    },

    "power_range": {
      "value": [20, 400],
      "unit": "",
      "type": "list",
      "subtype": "int",
      "info": "Laser power range (S parameter)",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('machine[machine_type[value]]') == 'laser' else me_set('meta[hidden]',True)",
        "constraints": {
          "arity": 2
           }
      }
    },

    "cut_power_range": {
      "value": [20, 400],
      "unit": "",
      "type": "list",
      "subtype": "int",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('machine[machine_type[value]]') == 'laser' else me_set('meta[hidden]',True)",
        "constraints": {
          "min":[0,0],
          "max":[1000,1000],
          "arity": 2
           }
      },
      "info": "Laser cutting power range"
    },

    "rate": {
      "value": 2000,
      "unit": "mm/min",
      "type": "int",
      "info": "Movement speed for this technique",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('technique[use_variable_rate[value]]') == False else me_set('meta[hidden]',True)"
      }
    },

    "use_variable_rate": {
      "value": false,
      "unit": "",
      "type": "bool",
      "info": "Enable dynamic speed based on image content",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('machine[machine_type[value]]') == 'laser' else me_set('meta[hidden]',True)"
      }
    },

    "z_retraction": {
      "value": 2,
      "unit": "mm",
      "type": "float",
      "info": "Z lift between moves",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if 'Z' in node_get('machine[axes[value]]') else me_set('meta[hidden]',True)"
      }
    },
    "lines_per_mm": { 
      "value": 5.0, 
      "unit": "lines/mm", 
      "type": "float",
      "info": "Lines per mm desnsity for output image",
      "meta":{
        "hidden":false
      } 
    },
    "direction": { 
      "value": "horizontal", 
      "unit": "", 
      "type": "str",
      "info": "Direction to make passes for linening and rastering",
      "meta": { 
        "hidden":false,
        "options": ["horizontal","vertical","diagonal","spiralin","spiralout"] 
      }
      },
      "recovery_distance": { 
        "value": 2.0, 
        "unit": "mm", 
        "type": "float",
        "info": "Additional distance without power to change speed and direction and not over expose corners",
        "meta": { 
          "hidden":false,
          "options": ["horizontal","vertical","diagonal","spiralin","spiralout"] 
        } 
      }

  },

  "image": {
    "file": {
      "value": "",
      "unit": "",
      "type": "str",
      "info": "File name with path to input image"
    },

    "color": {
      "value": "RGB",
      "unit": "",
      "type": "str",
      "info": "Color scheme",
      "user_modifiable":false
    },

    "process": {
      "value": "descrete",
      "unit": "",
      "type": "str",
      "info": "descrete to quantisize the colors into number of colors, continuous to set proportional value to color value",
      "meta":{
      "options":["descrete","continuous"]
      }
    },

    "number_of_colors": {
      "value": 8,
      "unit": "",
      "type": "int",
      "info": "Number of colors/layers (<256)",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('image[process[value]]') == 'descrete' else me_set('meta[hidden]',True)",
        "constraints": {
          "min":1,
          "max":256
           }
      }
    },

    "resolution": {
      "value": 0.5,
      "unit": "px/mm",
      "type": "float",
      "info": "Image resolution"
    },

    "selected_layers": {
      "value": [0,1,2,3,4,5,6,7],
      "unit": "",
      "type": "list",
      "subtype": "int",
      "meta":{
        "hidden":false,
        "editable":false
      },
      "info": "Layers to process (-1 = all)",
      "action":"layerDialog"
    },

    "draw_frame": {
      "value": false,
      "unit": "",
      "type": "bool",
      "info": "Draw a frame around the image"
    },

    "frame_offset": {
      "value": [0, 0],
      "unit": "mm",
      "type": "coords",
      "subtype": "float",
      "meta":{
        "hidden":false,
        "conditions": "me_set('meta[hidden]',False) if node_get('image[draw_frame[value]]') == True else me_set('meta[hidden]',True)",
        "constraints": {
          "min":[0,0],
          "max":[1000,1000],
          "arity": 2
           }
      },
      "info": "Frame offset relative to image"
    }
  },

  "output": {
    "gcode_path": {
      "value": "output.gcode",
      "unit": "",
      "type": "str",
      "info": "Output G-code file path"
    },

    "gcode_floating_decimals": {
      "value": 3,
      "unit": "",
      "type": "int",
      "info": "Sets the number of decimals for float parameters X,Y,Z in gcode."
    },

    "image_size": {
      "value": [100, 100, 0],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "meta":{
        "hidden":false,
        "constraints": {
          "arity": 3
           }
      },
      "info": "Final image size after processing"
    },

    "image_offset": {
      "value": [10, 10, 0],
      "unit": "mm",
      "type": "list",
      "subtype": "float",
      "meta":{
        "hidden":false,
        "constraints": {
          "arity": 3
           }
      },
      "info": "Offset of processed image in workspace"
    }
  }
}
